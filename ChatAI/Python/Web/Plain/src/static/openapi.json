{
    "openapi": "3.0.0",
    "info": {
        "title": "ChatAI API",
        "version": "1.0.0"
    },
    "paths": {
        "/health": {
            "get": {
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "Service status"
                    }
                }
            }
        },
        "/api/chat": {
            "post": {
                "summary": "Send a chat message",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "messages": {
                                        "type": "array",
                                        "items": {
                                            "type": "object",
                                            "properties": {
                                                "role": {
                                                    "type": "string"
                                                },
                                                "content": {
                                                    "type": "string"
                                                }
                                            },
                                            "required": [
                                                "role",
                                                "content"
                                            ]
                                        }
                                    },
                                    "model": {
                                        "type": "string"
                                    },
                                    "temperature": {
                                        "type": "number"
                                    },
                                    "max_tokens": {
                                        "type": "integer"
                                    }
                                },
                                "required": [
                                    "messages"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Chat response"
                    }
                }
            }
        }
    }
}
