{
    "openapi": "3.0.0",
    "info": {
        "title": "Conversor API",
        "version": "1.0.0"
    },
    "paths": {
        "/api/categories": {
            "get": {
                "summary": "List conversion categories",
                "responses": {
                    "200": {
                        "description": "Available categories and units"
                    }
                }
            }
        },
        "/api/convert": {
            "post": {
                "summary": "Convert a value",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "value": {
                                        "type": "number"
                                    },
                                    "from": {
                                        "type": "string"
                                    },
                                    "to": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "value",
                                    "from",
                                    "to"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Conversion result"
                    }
                }
            }
        }
    }
}
