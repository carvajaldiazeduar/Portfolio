<h1>Conversor</h1>
<% if @result %>
  <div class="result"><%= @result %><% if @unit %> <%= @unit %><% end %></div>
<% end %>
<% if @error %>
  <div class="alert"><%= @error %></div>
<% end %>
<div class="converter-form">
  <form action="<%= convert_path %>" method="post">
    <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
    <div class="field">
      <label>Value</label>
      <input type="number" name="value" step="any" required>
    </div>
    <div class="field">
      <label>From</label>
      <select name="from_unit">
        <% ConversorController::CATEGORIES.each do |label, units| %>
          <optgroup label="<%= label.capitalize %>">
            <% units.each do |unit| %>
              <option value="<%= unit %>"><%= unit %></option>
            <% end %>
          </optgroup>
        <% end %>
      </select>
    </div>
    <div class="field">
      <label>To</label>
      <select name="to_unit">
        <% ConversorController::CATEGORIES.each do |label, units| %>
          <optgroup label="<%= label.capitalize %>">
            <% units.each do |unit| %>
              <option value="<%= unit %>"><%= unit %></option>
            <% end %>
          </optgroup>
        <% end %>
      </select>
    </div>
    <button type="submit">Convert</button>
  </form>
</div>