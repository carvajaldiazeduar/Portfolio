{
    "openapi": "3.0.0",
    "info": {
        "title": "DataPipeline API",
        "version": "1.0.0"
    },
    "paths": {
        "/api/pipelines": {
            "get": {
                "summary": "List pipelines",
                "responses": {
                    "200": {
                        "description": "List of pipelines"
                    }
                }
            }
        },
        "/api/pipelines/{name}/run": {
            "post": {
                "summary": "Run a pipeline",
                "parameters": [
                    {
                        "name": "name",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": false,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "source": {
                                        "type": "string"
                                    },
                                    "query": {
                                        "type": "string"
                                    },
                                    "target": {
                                        "type": "string"
                                    },
                                    "schema": {
                                        "type": "object"
                                    }
                                },
                                "required": [
                                    "source"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Pipeline executed"
                    }
                }
            }
        },
        "/api/sources": {
            "get": {
                "summary": "List data sources",
                "responses": {
                    "200": {
                        "description": "List of sources"
                    }
                }
            }
        },
        "/api/health": {
            "get": {
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "Service status"
                    }
                }
            }
        }
    }
}
