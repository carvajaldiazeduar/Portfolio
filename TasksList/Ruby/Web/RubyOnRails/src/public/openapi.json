{
  "openapi": "3.0.0",
  "info": {
    "title": "TasksList API",
    "version": "1.0.0"
  },
  "paths": {
    "/tasks": {
      "post": {
        "summary": "Create a task",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["task"],
                "properties": {
                  "task": {
                    "type": "object",
                    "required": ["title"],
                    "properties": {
                      "title": { "type": "string" },
                      "description": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task created"
          }
        }
      }
    },
    "/tasks/{id}/complete": {
      "put": {
        "summary": "Mark a task as complete",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "Task completed"
          }
        }
      }
    },
    "/tasks/{id}": {
      "delete": {
        "summary": "Delete a task",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "Task deleted"
          }
        }
      }
    }
  }
}
