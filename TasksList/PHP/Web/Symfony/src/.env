APP_ENV=dev
APP_DEBUG=1
APP_SECRET=thisisnotasecret

# MongoDB: Doctrine has a separate MongoDB ODM (doctrine/mongodb-odm),
# not the standard ORM. Not configured here.

DB_DRIVER=pgsql
DB_HOST=db
DB_PORT=5432
DB_NAME=taskslist
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL="${DB_DRIVER}://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}"

# SQL Server (pdo_sqlsrv):
# DB_DRIVER=pdo_sqlsrv
# DB_HOST=host
# DB_PORT=1433
# DB_NAME=database
# DB_USER=user
# DB_PASSWORD=pass
