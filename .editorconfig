root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.php]
indent_size = 4

[*.py]
indent_size = 4

[*.cs]
indent_size = 4

[*.js]
indent_size = 2

[*.css]
indent_size = 2

[*.html]
indent_size = 2

[*.rb]
indent_size = 2

[*.ex]
indent_size = 2

[*.exs]
indent_size = 2

[*.sh]
indent_size = 2

[*.ps1]
end_of_line = crlf
indent_size = 2

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
