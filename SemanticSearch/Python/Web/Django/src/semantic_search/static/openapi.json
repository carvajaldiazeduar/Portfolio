{
    "openapi": "3.0.0",
    "info": {
        "title": "SemanticSearch API",
        "version": "1.0.0"
    },
    "paths": {
        "/api/search/": {
            "get": {
                "summary": "Search documents",
                "parameters": [
                    {
                        "name": "q",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Search results"
                    }
                }
            }
        },
        "/api/upload/": {
            "post": {
                "summary": "Upload a document",
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "file": {
                                        "type": "string",
                                        "format": "binary"
                                    }
                                },
                                "required": [
                                    "file"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Document indexed"
                    }
                }
            }
        },
        "/api/collections/": {
            "get": {
                "summary": "List collections",
                "responses": {
                    "200": {
                        "description": "List of collections"
                    }
                }
            }
        }
    }
}
