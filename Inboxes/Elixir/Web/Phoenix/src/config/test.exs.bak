import Config

# Test database config reads the same DB_DRIVER env as runtime.
# Defaults to SQLite with an in-repo test file so tests run without a server.
if System.get_env("DB_DRIVER") == "mysql" do
  config :inboxes, Contacts.Repo,
    adapter: Ecto.Adapters.MyXQL,
    hostname: System.get_env("DB_HOST", "localhost"),
    port: String.to_integer(System.get_env("DB_PORT", "3306")),
    username: System.get_env("DB_USER", "root"),
    password: System.get_env("DB_PASSWORD", ""),
    database: System.get_env("DB_NAME", "contacts_test"),
    pool: Ecto.Adapters.SQL.Sandbox,
    pool_size: 10
else
  config :inboxes, Contacts.Repo,
    adapter: Ecto.Adapters.SQLite3,
    database: System.get_env("DB_FILE", "test.db"),
    pool: Ecto.Adapters.SQL.Sandbox,
    pool_size: 10
end

config :inboxes,
  cache_type: System.get_env("CACHE_TYPE", "local"),
  redis_host: System.get_env("REDIS_HOST", "localhost:6379"),
  cache_ttl: String.to_integer(System.get_env("CACHE_TTL", "300"))

config :inboxes, InboxesWeb.Endpoint,
  http: [ip: {127, 0, 0, 1}, port: 4002],
  secret_key_base: "mCIqQX8G9t8SCCCSctpw4/WNucDi8t36MeOsDU8VVsyCw4uu419nTNYQSxCVcVM+",
  server: false

config :logger, level: :warning
config :phoenix, :plug_init_mode, :runtime
config :phoenix, sort_verified_routes_query_params: true
