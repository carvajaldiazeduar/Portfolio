<h1>Inboxes</h1>
<div class="form-row">
  <form action="<%= messages_path %>" method="post" id="addForm">
    <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
    <input type="text" name="message[sender]" placeholder="Sender" autofocus required>
    <input type="text" name="message[subject]" placeholder="Subject" required>
    <textarea name="message[body]" placeholder="Body"></textarea>
    <button type="submit">Add</button>
  </form>
</div>
<div class="search-row">
  <input type="text" id="searchInput" placeholder="Search by sender">
</div>
<div id="messageList">
  <% if @messages.empty? %>
    <div class="empty">No messages yet</div>
  <% else %>
    <table>
      <thead><tr><th>Sender</th><th>Subject</th><th>Read</th><th>Created</th><th></th><th></th></tr></thead>
      <tbody>
        <% @messages.each do |m| %>
          <tr>
            <td><%= m.sender %></td>
            <td><%= m.subject %></td>
            <td><%= m.read ? "Yes" : "No" %></td>
            <td><%= m.created_at %></td>
            <td><a href="<%= message_path(m) %>">Read</a></td>
            <td>
              <form action="<%= message_path(m) %>" method="post" onsubmit="return confirm('Delete?')">
                <input type="hidden" name="_method" value="delete">
                <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
                <button type="submit" class="delete-btn">Delete</button>
              </form>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>