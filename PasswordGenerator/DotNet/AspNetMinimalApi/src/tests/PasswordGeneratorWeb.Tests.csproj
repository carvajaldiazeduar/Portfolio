<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PasswordGeneratorWeb.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
      <UseDotNetTest>true</UseDotNetTest>

  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PasswordGeneratorWeb.csproj" />
  </ItemGroup>

  <!-- Workaround: prevent importing Microsoft.Testing.Platform MSBuild targets on .NET 10 SDK
       by excluding build assets for the transitive package. This avoids the MTP VSTest target
       that is incompatible with the new dotnet test experience. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Platform.MSBuild" Version="2.3.3">
      <ExcludeAssets>build;buildtransitive</ExcludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>






