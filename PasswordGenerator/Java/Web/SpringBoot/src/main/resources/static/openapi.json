{
  "openapi": "3.0.0",
  "info": {
    "title": "PasswordGenerator API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/generate": {
      "get": {
        "summary": "Generate a password",
        "parameters": [
          {
            "name": "length",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "uppercase",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "lowercase",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "numbers",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "symbols",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Generated password",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "password": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid length or character flags"
          }
        }
      }
    },
    "/api/passwords": {
      "get": {
        "summary": "List stored passwords",
        "responses": {
          "200": {
            "description": "List of stored passwords",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Store a password",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["password"],
                "properties": {
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Password stored",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Password is required"
          }
        }
      }
    },
    "/api/passwords/{id}": {
      "delete": {
        "summary": "Delete a stored password",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Password deleted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    }
  }
}
