generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PasswordEntry {
  id        Int      @id @default(autoincrement())
  password  String
  length    Int      @default(16)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("password_entries")
}
