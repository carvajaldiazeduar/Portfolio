{
    "openapi": "3.0.0",
    "info": {
        "title": "PasswordGenerator API",
        "version": "1.0.0"
    },
    "paths": {
        "/api/generate": {
            "post": {
                "summary": "Generate a password",
                "requestBody": {
                    "required": false,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "length": {
                                        "type": "integer",
                                        "default": 16
                                    },
                                    "use_upper": {
                                        "type": "boolean"
                                    },
                                    "use_lower": {
                                        "type": "boolean"
                                    },
                                    "use_digits": {
                                        "type": "boolean"
                                    },
                                    "use_symbols": {
                                        "type": "boolean"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Generated password"
                    }
                }
            }
        },
        "/api/passwords": {
            "get": {
                "summary": "List password history",
                "responses": {
                    "200": {
                        "description": "Recent password entries"
                    }
                }
            }
        }
    }
}
