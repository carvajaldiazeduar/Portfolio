<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Password Generator</title>
        <link rel='stylesheet' href='{{ asset('css/passwordgenerator.css') }}'>
</head>
<body>
    <div class="card">
        <h1>Password Generator</h1>
        <div class="form-group">
            <label for="length">Length</label>
            <input type="number" id="length" value="12" min="4" max="128">
        </div>
        <div class="checkbox-group">
            <label><input type="checkbox" id="useUpper" checked> Uppercase</label>
            <label><input type="checkbox" id="useLower" checked> Lowercase</label>
            <label><input type="checkbox" id="useDigits" checked> Digits</label>
            <label><input type="checkbox" id="useSymbols"> Symbols</label>
        </div>
        <button id="generateBtn">Generate</button>
        <div id="result" class="result"></div>
    </div>
        <script src='{{ asset('js/passwordgenerator.js') }}'></script>
</body>
</html>


