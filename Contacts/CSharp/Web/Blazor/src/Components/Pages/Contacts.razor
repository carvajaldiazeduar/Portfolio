@page "/contacts"
@inject ContactService contactService

<PageTitle>Contacts</PageTitle>

<h3>Contacts</h3>

@if (errorMsg != null)
{
    <div class="alert alert-danger">@errorMsg</div>
}

<EditForm EditContext="@editContext" OnSubmit="HandleSubmit">
    <DataAnnotationsValidator />
    <div class="mb-3">
        <div class="mb-2">
            <InputText @bind-Value="contactForm.Name" class="form-control" placeholder="Name" />
            <ValidationMessage For="() => contactForm.Name" class="text-danger" />
        </div>
        <div class="mb-2">
            <InputText @bind-Value="contactForm.Phone" class="form-control" placeholder="Phone" />
            <ValidationMessage For="() => contactForm.Phone" class="text-danger" />
        </div>
        <div class="mb-2">
            <InputText @bind-Value="contactForm.Email" class="form-control" placeholder="Email" />
            <ValidationMessage For="() => contactForm.Email" class="text-danger" />
        </div>
        <button type="submit" class="btn btn-primary">Add Contact</button>
    </div>
</EditForm>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Phone</th>
            <th>Email</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in contactList)
        {
            <tr>
                <td>@c.Id</td>
                <td>@c.Name</td>
                <td>@c.Phone</td>
                <td>@c.Email</td>
                <td><button class="btn btn-danger btn-sm" @onclick="() => DeleteContact(c.Id)">Delete</button></td>
            </tr>
        }
    </tbody>
</table>

@code {
    private List<Contact> contactList = new();
    private Contact contactForm = new();
    private EditContext editContext = default!;
    private string? errorMsg;

    protected override void OnInitialized()
    {
        ResetForm();
        Refresh();
    }

    private void ResetForm()
    {
        contactForm = new Contact();
        editContext = new EditContext(contactForm);
        editContext.SetFieldCssClassProvider(new BootstrapFieldCssClassProvider());
    }

    private void Refresh()
    {
        try { contactList = contactService.GetAll(); errorMsg = null; }
        catch (Exception e) { errorMsg = e.Message; }
    }

    private void HandleSubmit()
    {
        contactForm.Name = contactForm.Name?.Trim() ?? "";
        contactForm.Phone = contactForm.Phone?.Trim() ?? "";
        contactForm.Email = contactForm.Email?.Trim() ?? "";

        editContext.NotifyFieldChanged(editContext.Field(nameof(Contact.Name)));
        editContext.NotifyFieldChanged(editContext.Field(nameof(Contact.Phone)));
        editContext.NotifyFieldChanged(editContext.Field(nameof(Contact.Email)));

        if (!editContext.Validate())
        {
            return;
        }

        try
        {
            contactService.Add(contactForm.Name, contactForm.Phone, contactForm.Email);
            ResetForm();
            errorMsg = null;
            Refresh();
            StateHasChanged();
        }
        catch (Exception e)
        {
            errorMsg = e.Message;
        }
    }

    private void DeleteContact(int id)
    {
        try { contactService.Delete(id); errorMsg = null; Refresh(); }
        catch (Exception e) { errorMsg = e.Message; }
    }

    private class BootstrapFieldCssClassProvider : FieldCssClassProvider
    {
        public override string GetFieldCssClass(EditContext editContext, in FieldIdentifier fieldIdentifier)
        {
            var messages = editContext.GetValidationMessages(fieldIdentifier);
            if (!editContext.IsModified(fieldIdentifier))
            {
                return messages.Any() ? "is-invalid" : "";
            }
            return messages.Any() ? "is-invalid" : "is-valid";
        }
    }
}
