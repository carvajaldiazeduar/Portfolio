<h1>Contacts</h1>
<div class="form-row">
  <form action="<%= contacts_path %>" method="post" id="addForm">
    <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
    <div class="field">
      <input type="text" name="contact[name]" placeholder="Name" autofocus required
             value="<%= @contact&.name %>" class="<%= field_class(@contact, :name) %>">
      <% if field_error(@contact, :name) %>
        <span class="error-msg"><%= field_error(@contact, :name) %></span>
      <% end %>
    </div>
    <div class="field">
      <input type="text" name="contact[phone]" placeholder="Phone"
             value="<%= @contact&.phone %>" class="<%= field_class(@contact, :phone) %>">
      <% if field_error(@contact, :phone) %>
        <span class="error-msg"><%= field_error(@contact, :phone) %></span>
      <% end %>
    </div>
    <div class="field">
      <input type="email" name="contact[email]" placeholder="Email"
             value="<%= @contact&.email %>" class="<%= field_class(@contact, :email) %>">
      <% if field_error(@contact, :email) %>
        <span class="error-msg"><%= field_error(@contact, :email) %></span>
      <% end %>
    </div>
    <button type="submit">Add</button>
  </form>
</div>
<div class="search-row">
  <input type="text" id="searchInput" placeholder="Search by name">
</div>
<div id="contactList">
  <% if @contacts.empty? %>
    <div class="empty">No contacts yet</div>
  <% else %>
    <table>
      <thead><tr><th>Name</th><th>Phone</th><th>Email</th><th></th></tr></thead>
      <tbody>
        <% @contacts.each do |c| %>
          <tr>
            <td><%= c.name %></td>
            <td><%= c.phone %></td>
            <td><%= c.email %></td>
            <td>
              <form action="<%= contact_path(c) %>" method="post" onsubmit="return confirm('Delete?')">
                <input type="hidden" name="_method" value="delete">
                <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
                <button type="submit" class="delete-btn">Delete</button>
              </form>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
