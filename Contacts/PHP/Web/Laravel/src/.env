APP_NAME=Contacts
APP_ENV=local
APP_KEY=base64:WGH6VCua6C+lBwvXFsCFMIc3IaDrnakwtc87eO62TDc=
APP_DEBUG=true
APP_URL=http://localhost

# MongoDB: Laravel does not natively support MongoDB through Eloquent.
# Use a package like jenssegers/mongodb with mongodb://user:pass@host:port/database

DB_DRIVER=pgsql
DB_HOST=db
DB_PORT=5432
DB_NAME=contacts
DB_USER=postgres
DB_PASSWORD=postgres

# SQL Server (sqlsrv):
# DB_DRIVER=sqlserver
# DB_HOST=host
# DB_PORT=1433
# DB_NAME=database
# DB_USER=user
# DB_PASSWORD=pass

CACHE_TYPE=redis
REDIS_URL=redis://redis:6379